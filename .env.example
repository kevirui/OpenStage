# OpenStage Environment Variables
# Copy to .env at the repository root: cp .env.example .env

# --- Required for real captions ---
# Google AI Studio key with access to the Gemini Live API.
# Without it the backend still runs, but emits mock captions.
GEMINI_API_KEY=

# --- Optional ---
# Gemini Live model. The default returns the English transcription as input
# transcription and the Spanish translation as output transcription.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Path to the ffmpeg binary (used only to decode demo audio into raw PCM).
FFMPEG_PATH=ffmpeg

# Backend
PORT=4000
NODE_ENV=development

# Web frontend (must point at the backend above)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
