# Variables de entorno de OpenStage
# Copiar a .env en la raíz del repositorio: cp .env.example .env

# --- Requerida para subtítulos reales ---
# API key de Google AI Studio con acceso a la Gemini Live API.
# Sin ella el backend igual arranca, pero emite subtítulos mock.
GEMINI_API_KEY=

# --- Opcionales ---
# Modelo de Gemini Live. El valor por defecto devuelve la transcripción en
# inglés como transcripción de entrada y la traducción al español como
# transcripción de salida.
GEMINI_LIVE_MODEL=gemini-3.5-live-translate-preview

# Ruta al binario de ffmpeg (sólo se usa para decodificar el audio de demo a PCM crudo).
FFMPEG_PATH=ffmpeg

# Backend
PORT=4000
NODE_ENV=development

# Frontend web (debe apuntar al backend de arriba)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
